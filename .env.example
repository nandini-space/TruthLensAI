# Application
APP_ENV=
APP_HOST=
APP_PORT=
TRUTHLENS_CORS_ORIGINS=
# Optional shared service key. When set, all API routes except /health require
# X-TruthLens-API-Key. Configure the same value as an n8n credential, not here.
TRUTHLENSAI_API_KEY=
# Set a positive integer to enable the in-process per-IP/per-route minute limit.
TRUTHLENSAI_RATE_LIMIT_PER_MINUTE=60

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Threat intelligence
VIRUSTOTAL_API_KEY=

# Module 3C Telegram bot
TELEGRAM_BOT_TOKEN=

# Module 3C n8n workflow (set in the n8n process environment, never in its export)
TRUTHLENSAI_BACKEND_URL=http://your-truthlensai-backend:8000
TRUTHLENSAI_BACKEND_TIMEOUT_MS=30000
# Keep true for offline workflow demonstrations; set false to call Module 1.
TRUTHLENSAI_MOCK_MODE=true
